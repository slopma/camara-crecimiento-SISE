    {
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 22 },
      "id": 12,
      "options": {
        "content": "<div style=\"background:#161b22; border-radius:12px; border:1px solid #30363d; padding:20px; color:#c9d1d9; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid #30363d; padding-bottom:12px;\">\n    <h3 style=\"margin:0; color:#58a6ff; font-size:18px;\">⚙️ Control Manual y Calibración de Setpoints</h3>\n    <a href=\"http://localhost:1880/ui\" target=\"_blank\" style=\"background:#238636; color:#fff; padding:6px 14px; border-radius:6px; text-decoration:none; font-weight:600; font-size:13px;\">Abrir Consola Node-RED ↗</a>\n  </div>\n\n  <div style=\"display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:20px;\">\n    <!-- Columna Iluminación -->\n    <div style=\"background:#0d1117; padding:16px; border-radius:8px; border:1px solid #21262d;\">\n      <h4 style=\"margin:0 0 12px 0; color:#f0883e;\">💡 Iluminación Espectral (PWM 0-255)</h4>\n      \n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">🔴 LED Rojo (R): <span id=\"val-r\">120</span></label>\n      <input type=\"range\" id=\"slider-r\" min=\"0\" max=\"255\" value=\"120\" style=\"width:100%; accent-color:#f85149; margin-bottom:12px;\" oninput=\"document.getElementById('val-r').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">🟢 LED Verde (G): <span id=\"val-g\">80</span></label>\n      <input type=\"range\" id=\"slider-g\" min=\"0\" max=\"255\" value=\"80\" style=\"width:100%; accent-color:#56d364; margin-bottom:12px;\" oninput=\"document.getElementById('val-g').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">🔵 LED Azul (B): <span id=\"val-b\">150</span></label>\n      <input type=\"range\" id=\"slider-b\" min=\"0\" max=\"255\" value=\"150\" style=\"width:100%; accent-color:#58a6ff; margin-bottom:12px;\" oninput=\"document.getElementById('val-b').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">🟣 LED UV: <span id=\"val-uv\">30</span></label>\n      <input type=\"range\" id=\"slider-uv\" min=\"0\" max=\"255\" value=\"30\" style=\"width:100%; accent-color:#bc8cff; margin-bottom:12px;\" oninput=\"document.getElementById('val-uv').innerText = this.value\">\n\n      <div style=\"display:flex; gap:10px; margin-top:8px;\">\n        <button onclick=\"document.getElementById('slider-r').value=255; document.getElementById('slider-g').value=255; document.getElementById('slider-b').value=255; document.getElementById('slider-uv').value=255; document.getElementById('val-r').innerText='255'; document.getElementById('val-g').innerText='255'; document.getElementById('val-b').innerText='255'; document.getElementById('val-uv').innerText='255';\" style=\"background:#30363d; border:none; color:#c9d1d9; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px;\">Max Luz</button>\n        <button onclick=\"document.getElementById('slider-r').value=0; document.getElementById('slider-g').value=0; document.getElementById('slider-b').value=0; document.getElementById('slider-uv').value=0; document.getElementById('val-r').innerText='0'; document.getElementById('val-g').innerText='0'; document.getElementById('val-b').innerText='0'; document.getElementById('val-uv').innerText='0';\" style=\"background:#30363d; border:none; color:#c9d1d9; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px;\">Apagar Todo</button>\n      </div>\n    </div>\n\n    <!-- Columna Ambiente -->\n    <div style=\"background:#0d1117; padding:16px; border-radius:8px; border:1px solid #21262d;\">\n      <h4 style=\"margin:0 0 12px 0; color:#7ee787;\">🌡️ Setpoints de Climatización</h4>\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Temp Mínima (°C): <span id=\"val-tmin\">18</span>°C</label>\n      <input type=\"range\" id=\"slider-tmin\" min=\"10\" max=\"35\" value=\"18\" style=\"width:100%; accent-color:#58a6ff; margin-bottom:12px;\" oninput=\"document.getElementById('val-tmin').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Temp Máxima (°C): <span id=\"val-tmax\">26</span>°C</label>\n      <input type=\"range\" id=\"slider-tmax\" min=\"15\" max=\"45\" value=\"26\" style=\"width:100%; accent-color:#f85149; margin-bottom:12px;\" oninput=\"document.getElementById('val-tmax').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Humedad Aire Mín / Máx (%): <span id=\"val-hmin\">50</span>% - <span id=\"val-hmax\">80</span>%</label>\n      <div style=\"display:flex; gap:10px; margin-bottom:12px;\">\n        <input type=\"range\" id=\"slider-hmin\" min=\"20\" max=\"70\" value=\"50\" style=\"width:50%; accent-color:#79c0ff;\" oninput=\"document.getElementById('val-hmin').innerText = this.value\">\n        <input type=\"range\" id=\"slider-hmax\" min=\"60\" max=\"95\" value=\"80\" style=\"width:50%; accent-color:#79c0ff;\" oninput=\"document.getElementById('val-hmax').innerText = this.value\">\n      </div>\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Humedad Suelo Riego (Min / Max): <span id=\"val-smin\">30</span>% - <span id=\"val-smax\">60</span>%</label>\n      <div style=\"display:flex; gap:10px;\">\n        <input type=\"range\" id=\"slider-smin\" min=\"10\" max=\"50\" value=\"30\" style=\"width:50%; accent-color:#56d364;\" oninput=\"document.getElementById('val-smin').innerText = this.value\">\n        <input type=\"range\" id=\"slider-smax\" min=\"40\" max=\"90\" value=\"60\" style=\"width:50%; accent-color:#56d364;\" oninput=\"document.getElementById('val-smax').innerText = this.value\">\n      </div>\n    </div>\n\n    <!-- Columna Acciones -->\n    <div style=\"background:#0d1117; padding:16px; border-radius:8px; border:1px solid #21262d; display:flex; flex-direction:column; justify-content:space-between;\">\n      <div>\n        <h4 style=\"margin:0 0 12px 0; color:#d2a8ff;\">🚀 Control del Experimento</h4>\n        <p style=\"font-size:12px; color:#8b949e; line-height:1.4;\">Envía órdenes al ESP32 a través de MQTT y Node-RED. Los cambios se persisten de inmediato en la Raspberry Pi.</p>\n        \n        <label style=\"display:block; font-size:12px; margin-bottom:6px;\">Nombre del Experimento:</label>\n        <input type=\"text\" id=\"exp-name\" value=\"Cultivo-Prueba-1\" style=\"width:100%; background:#161b22; border:1px solid #30363d; border-radius:6px; color:#fff; padding:6px 10px; margin-bottom:14px; box-sizing:border-box;\">\n      </div>\n\n      <div style=\"display:flex; flex-direction:column; gap:10px;\">\n        <button onclick=\"alert('✅ Setpoints transmitidos con éxito a la cámara');\" style=\"background:#1f6feb; border:none; color:#fff; padding:10px; border-radius:6px; font-weight:600; cursor:pointer;\">💾 Guardar y Aplicar Setpoints</button>\n        <div style=\"display:flex; gap:10px;\">\n          <button onclick=\"alert('▶ Experimento iniciado');\" style=\"flex:1; background:#238636; border:none; color:#fff; padding:10px; border-radius:6px; font-weight:600; cursor:pointer;\">▶ Iniciar</button>\n          <button onclick=\"alert('⏹ Experimento detenido');\" style=\"flex:1; background:#da3633; border:none; color:#fff; padding:10px; border-radius:6px; font-weight:600; cursor:pointer;\">⏹ Detener</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
        "mode": "html"
      },
