      },
      "id": 12,
      "options": {
        "content": "<div style=\"background:#161b22; border-radius:12px; border:1px solid #30363d; padding:20px; color:#c9d1d9; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid #30363d; padding-bottom:12px;\">\n    <h3 style=\"margin:0; color:#58a6ff; font-size:18px;\">\ufe0f Control Manual y Calibraci\u00f3n de Setpoints</h3>\n    <a href=\"http://localhost:1880/ui\" target=\"_blank\" style=\"background:#238636; color:#fff; padding:6px 14px; border-radius:6px; text-decoration:none; font-weight:600; font-size:13px;\">Abrir Consola Node-RED \u2197</a>\n  </div>\n\n  <div style=\"display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:20px;\">\n    <!-- Columna Iluminaci\u00f3n -->\n    <div style=\"background:#0d1117; padding:16px; border-radius:8px; border:1px solid #21262d;\">\n      <h4 style=\"margin:0 0 12px 0; color:#f0883e;\">Iluminaci\u00f3n Espectral (PWM 0-255)</h4>\n      \n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">LED Rojo (R): <span id=\"val-r\">120</span></label>\n      <input type=\"range\" id=\"slider-r\" min=\"0\" max=\"255\" value=\"120\" style=\"width:100%; accent-color:#f85149; margin-bottom:12px;\" oninput=\"document.getElementById('val-r').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">LED Verde (G): <span id=\"val-g\">80</span></label>\n      <input type=\"range\" id=\"slider-g\" min=\"0\" max=\"255\" value=\"80\" style=\"width:100%; accent-color:#56d364; margin-bottom:12px;\" oninput=\"document.getElementById('val-g').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">LED Azul (B): <span id=\"val-b\">150</span></label>\n      <input type=\"range\" id=\"slider-b\" min=\"0\" max=\"255\" value=\"150\" style=\"width:100%; accent-color:#58a6ff; margin-bottom:12px;\" oninput=\"document.getElementById('val-b').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">LED UV: <span id=\"val-uv\">30</span></label>\n      <input type=\"range\" id=\"slider-uv\" min=\"0\" max=\"255\" value=\"30\" style=\"width:100%; accent-color:#bc8cff; margin-bottom:12px;\" oninput=\"document.getElementById('val-uv').innerText = this.value\">\n\n      <div style=\"display:flex; gap:10px; margin-top:8px;\">\n        <button onclick=\"document.getElementById('slider-r').value=255; document.getElementById('slider-g').value=255; document.getElementById('slider-b').value=255; document.getElementById('slider-uv').value=255; document.getElementById('val-r').innerText='255'; document.getElementById('val-g').innerText='255'; document.getElementById('val-b').innerText='255'; document.getElementById('val-uv').innerText='255';\" style=\"background:#30363d; border:none; color:#c9d1d9; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px;\">Max Luz</button>\n        <button onclick=\"document.getElementById('slider-r').value=0; document.getElementById('slider-g').value=0; document.getElementById('slider-b').value=0; document.getElementById('slider-uv').value=0; document.getElementById('val-r').innerText='0'; document.getElementById('val-g').innerText='0'; document.getElementById('val-b').innerText='0'; document.getElementById('val-uv').innerText='0';\" style=\"background:#30363d; border:none; color:#c9d1d9; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px;\">Apagar Todo</button>\n      </div>\n    </div>\n\n    <!-- Columna Ambiente -->\n    <div style=\"background:#0d1117; padding:16px; border-radius:8px; border:1px solid #21262d;\">\n      <h4 style=\"margin:0 0 12px 0; color:#7ee787;\">\ufe0f Setpoints de Climatizaci\u00f3n</h4>\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Temp M\u00ednima (\u00b0C): <span id=\"val-tmin\">18</span>\u00b0C</label>\n      <input type=\"range\" id=\"slider-tmin\" min=\"10\" max=\"35\" value=\"18\" style=\"width:100%; accent-color:#58a6ff; margin-bottom:12px;\" oninput=\"document.getElementById('val-tmin').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Temp M\u00e1xima (\u00b0C): <span id=\"val-tmax\">26</span>\u00b0C</label>\n      <input type=\"range\" id=\"slider-tmax\" min=\"15\" max=\"45\" value=\"26\" style=\"width:100%; accent-color:#f85149; margin-bottom:12px;\" oninput=\"document.getElementById('val-tmax').innerText = this.value\">\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Humedad Aire M\u00edn / M\u00e1x (%): <span id=\"val-hmin\">50</span>% - <span id=\"val-hmax\">80</span>%</label>\n      <div style=\"display:flex; gap:10px; margin-bottom:12px;\">\n        <input type=\"range\" id=\"slider-hmin\" min=\"20\" max=\"70\" value=\"50\" style=\"width:50%; accent-color:#79c0ff;\" oninput=\"document.getElementById('val-hmin').innerText = this.value\">\n        <input type=\"range\" id=\"slider-hmax\" min=\"60\" max=\"95\" value=\"80\" style=\"width:50%; accent-color:#79c0ff;\" oninput=\"document.getElementById('val-hmax').innerText = this.value\">\n      </div>\n\n      <label style=\"display:block; font-size:12px; margin-bottom:4px;\">Humedad Suelo Riego (Min / Max): <span id=\"val-smin\">30</span>% - <span id=\"val-smax\">60</span>%</label>\n      <div style=\"display:flex; gap:10px;\">\n        <input type=\"range\" id=\"slider-smin\" min=\"10\" max=\"50\" value=\"30\" style=\"width:50%; accent-color:#56d364;\" oninput=\"document.getElementById('val-smin').innerText = this.value\">\n        <input type=\"range\" id=\"slider-smax\" min=\"40\" max=\"90\" value=\"60\" style=\"width:50%; accent-color:#56d364;\" oninput=\"document.getElementById('val-smax').innerText = this.value\">\n      </div>\n    </div>\n\n    <!-- Columna Acciones -->\n    <div style=\"background:#0d1117; padding:16px; border-radius:8px; border:1px solid #21262d; display:flex; flex-direction:column; justify-content:space-between;\">\n      <div>\n        <h4 style=\"margin:0 0 12px 0; color:#d2a8ff;\">Control del Experimento</h4>\n        <p style=\"font-size:12px; color:#8b949e; line-height:1.4;\">Env\u00eda \u00f3rdenes al ESP32 a trav\u00e9s de MQTT y Node-RED. Los cambios se persisten de inmediato en la Raspberry Pi.</p>\n        \n        <label style=\"display:block; font-size:12px; margin-bottom:6px;\">Nombre del Experimento:</label>\n        <input type=\"text\" id=\"exp-name\" value=\"Cultivo-Prueba-1\" style=\"width:100%; background:#161b22; border:1px solid #30363d; border-radius:6px; color:#fff; padding:6px 10px; margin-bottom:14px; box-sizing:border-box;\">\n      </div>\n\n      <div style=\"display:flex; flex-direction:column; gap:10px;\">\n        <button onclick=\"var sp={ledr:parseInt(document.getElementById('slider-r').value),ledg:parseInt(document.getElementById('slider-g').value),ledb:parseInt(document.getElementById('slider-b').value),leduv:parseInt(document.getElementById('slider-uv').value),temp_min:parseFloat(document.getElementById('slider-tmin').value),temp_max:parseFloat(document.getElementById('slider-tmax').value),hum_min:parseFloat(document.getElementById('slider-hmin').value),hum_max:parseFloat(document.getElementById('slider-hmax').value),hum_suelo_min:parseFloat(document.getElementById('slider-smin').value),hum_suelo_max:parseFloat(document.getElementById('slider-smax').value)}; fetch('http://'+window.location.hostname+':8083/api/sp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(sp)}).then(r=>r.json()).then(d=>alert('Setpoints transmitidos y aplicados con \u00e9xito')).catch(e=>alert('Error: '+e));\" style=\"background:#1f6feb; border:none; color:#fff; padding:10px; border-radius:6px; font-weight:600; cursor:pointer;\">Guardar y Aplicar Setpoints</button>\n        <div style=\"display:flex; gap:10px;\">\n          <button onclick=\"var n=document.getElementById('exp-name').value; fetch('http://'+window.location.hostname+':8083/api/start?name='+encodeURIComponent(n)).then(r=>r.json()).then(d=>alert('Experimento iniciado: '+n)).catch(e=>alert('Error: '+e));\" style=\"flex:1; background:#238636; border:none; color:#fff; padding:10px; border-radius:6px; font-weight:600; cursor:pointer;\">Iniciar</button>\n          <button onclick=\"fetch('http://'+window.location.hostname+':8083/api/stop').then(r=>r.json()).then(d=>alert('Experimento detenido')).catch(e=>alert('Error: '+e));\" style=\"flex:1; background:#da3633; border:none; color:#fff; padding:10px; border-radius:6px; font-weight:600; cursor:pointer;\">Detener</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
