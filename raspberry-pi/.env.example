# Dispositivo serie físico del ESP32 en el host (se monta en /dev/ttyUSB0 dentro del contenedor)
MODULE_DEVICE=/dev/ttyUSB0

# Configuración del puerto serie interno
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Configuración del Broker MQTT
MQTT_BROKER=tcp://mqtt.dis.eafit.edu.co:1883
MQTT_CLIENT_ID=sise-camara-crecimiento-modulo1
MQTT_USER=admin
MQTT_PASSWORD=semillero
MQTT_TOPIC_PREFIX=/sise/camara-crecimiento/m1

# Configuración de transmisión de video (stream.sh)
RTMP_SERVER_URL=rtmp://localhost:1935/live/m1
VIDEO_DEVICE=/dev/video0
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=25
VIDEO_BITRATE=1500k

